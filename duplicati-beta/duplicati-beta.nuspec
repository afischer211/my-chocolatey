  <metadata>
    <id>duplicati</id>
    <version>2.3.1.1-beta</version>
    <packageSourceUrl>https://github.com/afischer211/my-chocolatey/tree/master/duplicati-beta</packageSourceUrl>
    <owners>bcurran3,afischer211</owners>
    <title>Duplicati (Install) - Beta</title>
    <authors>Kenneth Skovhede and Rene Stach</authors>
    <projectUrl>http://www.duplicati.com/</projectUrl>
    <iconUrl>http://www.duplicati.com/images/duplicati-fb-share-v1.png</iconUrl>
    <licenseUrl>https://github.com/duplicati/duplicati/blob/master/LICENSE</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <projectSourceUrl>https://github.com/duplicati/duplicati</projectSourceUrl>
